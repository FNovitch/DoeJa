{
  "name": "doeja",
  "version": "1.0.0",
  "description": "Plataforma para conectar doadores a pessoas e familias em situacao de necessidade.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "tsx src/db/seed.ts",
    "seed:prod": "node dist/db/seed.js",
    "postinstall": "npm rebuild sqlite3 --build-from-source"
  },
  "keywords": [
    "node",
    "express",
    "sqlite",
    "doacao",
    "landing-page"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "sqlite3": "^6.0.1"
  },
  "engines": {
    "node": "18.x"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^18.19.130",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FNovitch/DoeJa.git"
  },
  "bugs": {
    "url": "https://github.com/FNovitch/DoeJa/issues"
  },
  "homepage": "https://github.com/FNovitch/DoeJa#readme"
}
