{
  "name": "doeja",
  "version": "1.0.0",
  "description": "Plataforma para conectar doadores a pessoas e familias em situacao de necessidade.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "check:frontend": "tsc -p tsconfig.frontend.json",
    "lint": "eslint index.js public/scripts tests/unit eslint.config.mjs",
    "format": "prettier --write public tests index.js *.json *.md *.mjs *.ts",
    "format:check": "prettier --check public tests index.js *.json *.md *.mjs *.ts",
    "test": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm run build && npm run check:frontend && npm run lint && npm run format:check && npm test",
    "start": "node dist/index.js",
    "seed": "tsx src/db/seed.ts",
    "seed:prod": "node dist/db/seed.js",
    "postinstall": "npm run build"
  },
  "keywords": [
    "node",
    "express",
    "sqlite",
    "doacao",
    "landing-page"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "sqlite3": "^6.0.1"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.55.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.0",
    "globals": "^15.14.0",
    "playwright-core": "^1.55.0",
    "prettier": "^3.9.6",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FNovitch/DoeJa.git"
  },
  "bugs": {
    "url": "https://github.com/FNovitch/DoeJa/issues"
  },
  "homepage": "https://github.com/FNovitch/DoeJa#readme"
}
