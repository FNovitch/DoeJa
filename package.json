{
  "name": "doeja",
  "version": "1.0.0",
  "description": "Plataforma para conectar doadores a pessoas e familias em situacao de necessidade.",
  "main": "dist/index.js",
  "scripts": {
    "predev": "npm run build",
    "dev": "concurrently -k -n types,server,css -c yellow,cyan,magenta \"npm:dev:types\" \"npm:dev:server\" \"npm:dev:css\"",
    "dev:types": "tsc --watch --preserveWatchOutput",
    "dev:server": "node --watch dist/index.js",
    "dev:css": "tailwindcss -i ./styles/tailwind.css -o ./public/styles/app.css --watch",
    "build": "npm run build:server && npm run build:css",
    "build:server": "tsc",
    "build:css": "tailwindcss -i ./styles/tailwind.css -o ./public/styles/app.css --minify",
    "check:frontend": "tsc -p tsconfig.frontend.json",
    "check:tests": "tsc -p tsconfig.tests.json",
    "lint": "eslint index.js src public/scripts tests playwright.config.ts eslint.config.mjs",
    "format": "prettier --write public tests styles index.js *.json *.md *.mjs *.ts",
    "format:check": "prettier --check public tests styles index.js *.json *.md *.mjs *.ts",
    "test": "npm run build:server && node --test tests/unit/*.test.mjs tests/integration/*.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run build && npm run check:frontend && npm run check:tests && npm run lint && npm run format:check && node --test tests/unit/*.test.mjs tests/integration/*.test.mjs",
    "start": "node dist/index.js",
    "seed": "npm run build:server && node dist/db/seed.js",
    "seed:prod": "node dist/db/seed.js",
    "postinstall": "npm run build"
  },
  "keywords": [
    "node",
    "express",
    "sqlite",
    "tailwindcss",
    "doacao",
    "landing-page"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "sqlite3": "^6.0.1"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/cli": "^4.3.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "concurrently": "^10.0.4",
    "eslint": "^9.39.0",
    "globals": "^15.14.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FNovitch/DoeJa.git"
  },
  "bugs": {
    "url": "https://github.com/FNovitch/DoeJa/issues"
  },
  "homepage": "https://github.com/FNovitch/DoeJa#readme"
}
